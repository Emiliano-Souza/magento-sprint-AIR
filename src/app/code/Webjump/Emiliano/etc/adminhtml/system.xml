<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">

    <system>
        <section id="webjump_emiliano"
                 translate="label"
                 sortOrder="900"
                 showInDefault="1"
                 showInWebsite="1"
                 showInStore="1">

            <label>Oak &amp; Barrel</label>
            <tab>general</tab>
            <resource>Magento_Config::config</resource>

            <group id="home"
                   translate="label"
                   sortOrder="10"
                   showInDefault="1"
                   showInWebsite="1"
                   showInStore="1">

                <label>Home Block</label>

                <field id="message"
                       translate="label comment"
                       type="text"
                       sortOrder="10"
                       showInDefault="1"
                       showInWebsite="1"
                       showInStore="1">

                    <label>Message</label>
                    <comment>Text displayed in the Oak &amp; Barrel block on the Home page.</comment>

                </field>

            </group>

        </section>
    </system>
</config>