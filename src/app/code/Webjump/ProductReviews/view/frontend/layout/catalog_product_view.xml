<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="product.info.main">
            <block class="Magento\Catalog\Block\Product\View"
                   name="webjump.product.sustainable.seal"
                   template="Webjump_ProductReviews::product/sustainable-seal.phtml"/>
            <block class="Magento\Catalog\Block\Product\View"
                name="webjump.product.reviews"
                template="Webjump_ProductReviews::product/reviews.phtml">
                <arguments>
                    <argument name="view_model"
                            xsi:type="object">
                        Webjump\ProductReviews\ViewModel\ProductReviews
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>

</page>