<?php

/** @var \Magento\Framework\View\Element\Template $block */

$product = $block->getData('product');

if (!$product && method_exists($block, 'getProduct')) {
    $product = $block->getProduct();
}

$isSustainable = $product
    ? (bool) $product->getData('sustainable_seal')
    : false;
?>

<?php if ($isSustainable): ?>
    <div class="webjump-sustainable-seal">
        <?= $block->escapeHtml(__('Selo Sustentável')) ?>
    </div>
<?php endif; ?>