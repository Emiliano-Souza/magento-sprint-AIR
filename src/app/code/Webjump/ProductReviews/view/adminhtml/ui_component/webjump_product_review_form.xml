<?xml version="1.0"?>
<form xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">

    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">
                webjump_product_review_form.webjump_product_review_form_data_source
            </item>
        </item>

        <item name="label" xsi:type="string" translate="true">
            Product Review
        </item>

        <item name="template" xsi:type="string">
            templates/form/collapsible
        </item>
        
    </argument>

    <settings>
        <buttons>
            <button name="back"
                    class="Webjump\ProductReviews\Block\Adminhtml\Review\Edit\BackButton"/>

            <button name="delete"
                    class="Webjump\ProductReviews\Block\Adminhtml\Review\Edit\DeleteButton"/>

            <button name="save"
                    class="Webjump\ProductReviews\Block\Adminhtml\Review\Edit\SaveButton"/>
        </buttons>

        <namespace>webjump_product_review_form</namespace>
        <dataScope>data</dataScope>

        <deps>
            <dep>
                webjump_product_review_form.webjump_product_review_form_data_source
            </dep>
        </deps>
    </settings>

    <dataSource name="webjump_product_review_form_data_source">
        <argument name="data" xsi:type="array">
            <item name="js_config" xsi:type="array">
                <item name="component" xsi:type="string">
                    Magento_Ui/js/form/provider
                </item>
            </item>
        </argument>

        <settings>
            <submitUrl path="webjump_productreviews/review/save"/>
        </settings>

        <dataProvider
            class="Webjump\ProductReviews\Model\ProductReview\DataProvider"
            name="webjump_product_review_form_data_source">

            <settings>
                <requestFieldName>review_id</requestFieldName>
                <primaryFieldName>review_id</primaryFieldName>
            </settings>

        </dataProvider>
    </dataSource>

    <fieldset name="general">
        <settings>
            <label translate="true">Review Information</label>
        </settings>

        <field name="review_id" formElement="hidden">
            <settings>
                <dataType>number</dataType>
                <dataScope>review_id</dataScope>
            </settings>
        </field>

        <field name="product_id" sortOrder="10" formElement="input">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Product ID</label>
                <dataScope>product_id</dataScope>

                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>

        <field name="author" sortOrder="20" formElement="input">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Author</label>
                <dataScope>author</dataScope>

                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                </validation>
            </settings>
        </field>

        <field name="comment" sortOrder="30" formElement="textarea">
            <settings>
                <dataType>text</dataType>
                <label translate="true">Comment</label>
                <dataScope>comment</dataScope>
            </settings>
        </field>

        <field name="rating" sortOrder="40" formElement="input">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Rating</label>
                <dataScope>rating</dataScope>

                <validation>
                    <rule name="required-entry" xsi:type="boolean">true</rule>
                    <rule name="validate-digits" xsi:type="boolean">true</rule>
                    <rule name="validate-number-range" xsi:type="string">1-5</rule>
                </validation>
            </settings>
        </field>

        <field name="approved" sortOrder="50" formElement="select">
            <settings>
                <dataType>number</dataType>
                <label translate="true">Approved</label>
                <dataScope>approved</dataScope>
            </settings>

            <formElements>
                <select>
                    <settings>
                        <options class="Magento\Config\Model\Config\Source\Yesno"/>
                    </settings>
                </select>
            </formElements>
        </field>

    </fieldset>

</form>