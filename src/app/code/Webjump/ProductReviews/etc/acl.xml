<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">

    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource
                    id="Webjump_ProductReviews::product_reviews"
                    title="Product Reviews"
                    sortOrder="100">

                    <resource
                        id="Webjump_ProductReviews::reviews"
                        title="Reviews"
                        sortOrder="10"/>

                    <resource
                        id="Webjump_ProductReviews::reviews_export"
                        title="Export Reviews"
                        sortOrder="20"/>

                </resource>
            </resource>
        </resources>
    </acl>

</config>